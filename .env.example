# Copy to .env and fill in. Never commit .env.

# sim   = synthetic market, fake money, no account needed (default)
# paper = broker paper account (real market data, fake money)
# live  = REAL MONEY. Only after extensive backtesting and paper trading.
MODE=sim

# ibkr (Interactive Brokers, via TWS or IB Gateway) | alpaca (US only)
BROKER=ibkr

# --- Interactive Brokers ---
# TWS or IB Gateway must be running and logged in on this machine, with the API enabled.
IB_HOST=127.0.0.1
# Leave 0 for IB Gateway defaults (4002 paper / 4001 live). TWS uses 7497 paper / 7496 live.
IB_PORT=0
IB_CLIENT_ID=17
# Optional: pick one account if your login manages several (paper accounts start with DU)
IB_ACCOUNT=

# --- Alpaca (US) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_FEED=iex

# --- Claude summaries on trade approvals (optional) ---
# With a key set (and `pip install anthropic`), each approval request gets a short plain-language
# summary. Leave blank to skip; approvals still work and show the strategy's own numbers.
ANTHROPIC_API_KEY=

# Required in addition to MODE=live, as a deliberate safety catch
I_UNDERSTAND_LIVE_TRADING=no

# Seconds between engine ticks (0 = default: 1s sim, 15s IBKR, 30s Alpaca)
TICK_SECONDS=0
